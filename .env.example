# Supabase — kopieer naar .env.local en vul in met je projectgegevens.
# Te vinden in het Supabase-dashboard onder Project Settings → API.
#
# LET OP: beide variabelen zijn NEXT_PUBLIC_* en worden naar de browser
# gestuurd. Gebruik voor de key de PUBLISHABLE/anon key (sb_publishable_… of
# de klassieke anon-JWT), NOOIT een secret/service-role key (sb_secret_…).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
